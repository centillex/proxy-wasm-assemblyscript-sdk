{
  "name": "@centillex/proxy-wasm-sdk",
  "version": "0.1.0-alpha.1",
  "description": "Centillex-maintained AssemblyScript SDK for the Proxy-Wasm ABI",
  "license": "Apache-2.0",
  "author": "Yuval Kohavi",
  "contributors": ["Kong contributors", "Centillex contributors"],
  "repository": {"type": "git", "url": "git+https://github.com/centillex/proxy-wasm-assemblyscript-sdk.git"},
  "bugs": {"url": "https://github.com/centillex/proxy-wasm-assemblyscript-sdk/issues"},
  "homepage": "https://github.com/centillex/proxy-wasm-assemblyscript-sdk#readme",
  "keywords": ["assemblyscript", "proxy-wasm", "nginx", "wasm"],
  "type": "module",
  "main": "./index.ts",
  "ascMain": "./assembly/index.ts",
  "exports": {
    ".": "./index.ts",
    "./proxy": "./proxy.ts",
    "./package.json": "./package.json"
  },
  "files": ["assembly", "index.ts", "proxy.ts", "LICENSE.txt", "NOTICE", "SECURITY.md", "MAINTAINING.md", "CHANGELOG.md", "UPSTREAM.json", "docs/compatibility.md", "examples/header-filter.ts"],
  "engines": {"node": ">=22"},
  "peerDependencies": {"assemblyscript": "0.27.32"},
  "devDependencies": {"assemblyscript": "0.27.32"},
  "publishConfig": {"access": "public", "tag": "next", "registry": "https://registry.npmjs.org/"},
  "scripts": {
    "test": "node scripts/package-test.mjs",
    "test:native": "node scripts/native-test.mjs",
    "monitor": "node scripts/monitor-upstream.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm run release:check"
  }
}
